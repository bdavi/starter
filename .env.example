# Copy to .env and fill in. .env is gitignored; this file is the template.

# Postgres, via docker-compose.yml (docker compose up -d)
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter

# Better Auth
# Generate with: pnpm exec @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OpenTelemetry Collector, via docker-compose.yml (ADR-00018) — run
# `pnpm run otel:sync` before `docker compose up -d` the first time (or
# after pulling changes to services/otel-collector/), see its README.md.
# Must be >= 32 bytes — generate with: openssl rand -hex 32
OTEL_REDACTION_HMAC_KEY=
# The values below are correct as-is for local dev — docker-compose.yml
# runs real Loki/Tempo/Mimir locally (ADR-00021), reachable at these
# in-network hostnames. Point at your real Grafana Cloud (or other hosted)
# endpoints instead in any non-local environment.
OTEL_LOKI_OTLP_ENDPOINT=http://loki:3100/otlp
OTEL_TEMPO_OTLP_ENDPOINT=http://tempo:4318
OTEL_MIMIR_OTLP_ENDPOINT=http://mimir:9009/otlp

# Sentry (ADR-00017) — the Collector's sentryexporter (org-management API +
# OTLP ingestion), NOT the same thing as SENTRY_DSN below. No local
# self-hosted equivalent exists (ADR-00021) — GlitchTip below only covers
# the direct-SDK path. These three placeholder values are deliberate for
# local dev: the Collector requires non-empty strings to start at all, but
# nothing real is listening, so this path silently fails to export locally
# (verified: doesn't crash the Collector or affect any other pipeline). Set
# real values (auth_token needs project:read + org:read scope) in any
# environment where this path should actually be exercised.
SENTRY_URL=http://sentry.invalid
SENTRY_ORG_SLUG=local-dev-unused
SENTRY_AUTH_TOKEN=local-dev-unused

# GlitchTip (ADR-00021), via docker-compose.yml — self-hosted local stand-in
# for Sentry's direct-SDK path only (see SENTRY_DSN below). Any random
# string works; generate with: openssl rand -hex 32
GLITCHTIP_SECRET_KEY=

# apps/web -> local Collector (ADR-00020) — the Collector's OTLP/HTTP port,
# mapped to the host by docker-compose.yml.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional — the direct-SDK half of ADR-00017's dual Sentry path
# (Sentry.captureException(), not the Collector-routed traces). A project
# DSN, not the auth_token above. For local dev: sign in at
# http://localhost:8000 (GlitchTip, ADR-00021), create an org + project,
# and copy its DSN here — there's no way to provision this without a
# one-time manual step, same as a real Sentry.io DSN would need.
SENTRY_DSN=
