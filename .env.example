# Copy to .env and fill in. .env is gitignored; this file is the template.

# Postgres, via docker-compose.yml (docker compose up -d)
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter

# Better Auth
# Generate with: pnpm exec @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
