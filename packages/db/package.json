{
  "name": "@starter/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "db",
    "tags": [
      "type:lib"
    ],
    "targets": {
      "db-generate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/db",
          "command": "drizzle-kit generate"
        }
      },
      "db-migrate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/db",
          "command": "drizzle-kit migrate"
        }
      }
    }
  },
  "dependencies": {
    "@starter/config": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "server-only": "^0.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
