{
  "name": "@starter/observability",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./external-packages": {
      "types": "./src/lib/external-packages.ts",
      "import": "./src/lib/external-packages.ts",
      "default": "./src/lib/external-packages.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "observability",
    "tags": [
      "type:lib"
    ]
  },
  "peerDependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-pino": "0.66.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "10.67.0",
    "@starter/config": "workspace:*",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "server-only": "^0.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
