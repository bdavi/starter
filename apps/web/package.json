{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "type:app"
    ],
    "targets": {
      "typegen": {
        "cache": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/web",
          "command": "next typegen"
        },
        "inputs": [
          "default",
          "^default"
        ],
        "outputs": [
          "{projectRoot}/next-env.d.ts",
          "{projectRoot}/.next/types"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "typegen"
        ],
        "cache": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/web",
          "command": "tsc --noEmit -p tsconfig.json"
        },
        "inputs": [
          "default",
          "^default"
        ],
        "outputs": []
      },
      "lint": {
        "dependsOn": [
          "typegen"
        ]
      }
    }
  },
  "dependencies": {
    "@starter/auth": "workspace:*",
    "better-auth": "^1.6.23",
    "next": "~16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3"
  }
}
